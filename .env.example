HOST=0.0.0.0
PORT=8787
WEB_PORT=8388
MIN_DELAY_MS=3000
MAX_DELAY_MS=7000
MAX_ITEMS=100
MAX_CONCURRENT_SCANS=10

POSTGRES_PASSWORD=auditor
DATABASE_URL=postgres://auditor:auditor@postgres:5432/price_auditor

# Đổi secret này trước khi dùng thật. Không commit file .env.
JWT_SECRET=change-this-secret
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=604800

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_DISPLAY_NAME=Admin

# Origin dashboard trong LAN. Thêm đúng IP server. Không dùng *.
ALLOWED_ORIGINS=http://192.168.1.100:8388,http://192.168.1.100:3000,http://127.0.0.1:8388,http://127.0.0.1:3000

# Điền ID extension sau khi Load unpacked nếu muốn khóa CORS vào đúng một extension.
EXTENSION_ID=

BACKUP_DIR=./backups
SQLITE_IMPORT_PATH=./data/checker.db
